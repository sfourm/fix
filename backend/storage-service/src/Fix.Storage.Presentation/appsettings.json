{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Grpc": {
    "EnableReflection": true
  },
  "Core": {
    "Address": "http://localhost:5098",
    "TimeoutSeconds": 30
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "fix_storage"
  },
  "S3": {
    "Bucket": "fix-files",
    "Region": "us-east-1",
    "ForcePathStyle": false,
    "CreateBucket": false
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672/",
    "Exchange": "fix.files",
    "LinePrefetch": 1
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "fix-storage",
    "OtlpEndpoint": "http://localhost:4317"
  }
}
