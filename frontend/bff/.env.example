PORT=3000
# Endereço gRPC do core .NET
CORE_GRPC_URL=localhost:5098
CORE_GRPC_TLS=false
CORE_GRPC_DEADLINE_MS=10000
# files = carrega os .proto da raiz do repositório | reflection = obtém os contratos via server reflection do core
GRPC_CONTRACTS=files
PROTOS_DIR=../../protos
# Assinatura do token de sessão emitido para o web (mínimo 32 caracteres)
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
SESSION_TTL=8h
CORS_ORIGIN=http://localhost:5173
# Dashboards e filtros salvos (domínio do BFF) — docker compose up -d nesta pasta
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=fix
# Cache de visualização (linhas lidas do core para pesquisas e widgets); sem Redis o BFF segue sem cache
REDIS_URL=redis://localhost:6379
VIZ_CACHE_TTL_SECONDS=30
