# Valores do ambiente (gerados pelo Terraform e guardados no SSM em helm-values; o fix-deploy aplica a cada deploy).
# A versão das imagens vem do chart publicado pelo pipeline (appVersion = SHA do build).
image:
  registry: ${image_registry}
%{ if use_ghcr_auth ~}
  pullSecrets:
    - name: ghcr-pull
%{ endif ~}
ingress:
  host: "${host}"
  tls:
    enabled: ${enable_tls}
observability:
  enabled: ${enable_observability}
  grafana:
    host: "${grafana_host}"
