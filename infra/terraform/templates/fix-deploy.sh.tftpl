#!/bin/bash
# Deploy da plataforma Fix no k3s local. Chamado pelo GitHub Actions via SSM Run Command:
#   fix-deploy <chart-oci> <chart-version> <image-tag>
#   fix-deploy --sync-only           # só sincroniza valores, segredos, emissor de certificados e login no GHCR
# A configuração do ambiente vem do SSM Parameter Store (${ssm_prefix}/*), mantido pelo Terraform:
#   helm-values (valores do chart), segredos da aplicação, letsencrypt-email e, opcional, ghcr-username/ghcr-token.
set -euo pipefail
export PATH="/usr/local/bin:$PATH"
export KUBECONFIG="$${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
export HOME="$${HOME:-/root}"
VALUES_FILE="$${FIX_VALUES_FILE:-/etc/fix/values.yaml}"
STATE_DIR="$${FIX_STATE_DIR:-/var/lib/fix}"
export AWS_DEFAULT_REGION="${aws_region}"
SSM_PREFIX="${ssm_prefix}"

# Parâmetro do SSM ("" se não existir).
param() { aws ssm get-parameter --name "$SSM_PREFIX/$1" --with-decryption --query Parameter.Value --output text 2>/dev/null || true; }

sync_config() {
  kubectl create namespace fix --dry-run=client -o yaml | kubectl apply -f - >/dev/null

  # Valores do ambiente (domínios, TLS, observabilidade, registry)
  mkdir -p "$(dirname "$VALUES_FILE")"
  param helm-values > "$VALUES_FILE.tmp"
  [ -s "$VALUES_FILE.tmp" ] || { echo "parâmetro $SSM_PREFIX/helm-values não encontrado"; exit 4; }
  mv "$VALUES_FILE.tmp" "$VALUES_FILE"

  # Segredos da aplicação (SSM → Secret fix-secrets)
  kubectl -n fix create secret generic fix-secrets \
    --from-literal=postgres-password="$(param postgres-password)" \
    --from-literal=session-secret="$(param session-secret)" \
    --from-literal=admin-email="$(param admin-email)" \
    --from-literal=admin-password="$(param admin-password)" \
    --from-literal=grafana-admin-password="$(param grafana-admin-password)" \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null

  # Emissor Let's Encrypt (HTTP-01 pelo ingress-nginx); e-mail opcional ("-" = sem e-mail)
  local email
  email="$(param letsencrypt-email)"
  {
    echo "apiVersion: cert-manager.io/v1"
    echo "kind: ClusterIssuer"
    echo "metadata: { name: letsencrypt }"
    echo "spec:"
    echo "  acme:"
    echo "    server: https://acme-v02.api.letsencrypt.org/directory"
    if [ -n "$email" ] && [ "$email" != "-" ]; then echo "    email: \"$email\""; fi
    echo "    privateKeySecretRef: { name: letsencrypt-account-key }"
    echo "    solvers:"
    echo "      - http01: { ingress: { ingressClassName: nginx } }"
  } | kubectl apply -f - >/dev/null

  ghcr_login
  echo "configuração sincronizada do SSM ($SSM_PREFIX)"
}

ghcr_login() {
  local user token
  user="$(param ghcr-username)"
  token="$(param ghcr-token)"
  [ -n "$token" ] || return 0
  echo "$token" | helm registry login ghcr.io --username "$user" --password-stdin >/dev/null
  kubectl -n fix create secret docker-registry ghcr-pull \
    --docker-server=ghcr.io --docker-username="$user" --docker-password="$token" \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null
  echo "login no GHCR renovado"
}

if [ "$${1:-}" = "--sync-only" ] || [ "$${1:-}" = "--login-only" ]; then
  sync_config
  exit 0
fi

CHART="$${1:?informe o chart OCI}"
VERSION="$${2:?informe a versão do chart}"
TAG="$${3:?informe a tag das imagens}"

# Entradas vêm do pipeline: valida o formato antes de usar.
[[ "$CHART" =~ ^oci://ghcr\.io/[a-z0-9._/-]+$ ]] || { echo "chart inválido: $CHART"; exit 2; }
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?$ ]] || { echo "versão inválida: $VERSION"; exit 2; }
[[ "$TAG" =~ ^[A-Za-z0-9._-]{1,128}$ ]] || { echo "tag inválida: $TAG"; exit 2; }

[ -f "$STATE_DIR/bootstrap-done" ] || { echo "bootstrap do nó ainda não terminou"; exit 3; }

sync_config
echo "==> helm upgrade fix $CHART@$VERSION (imagens :$TAG)"
helm upgrade --install fix "$CHART" --version "$VERSION" \
  --namespace fix --create-namespace \
  --values "$VALUES_FILE" \
  --set image.tag="$TAG" \
  --wait --timeout 12m --atomic

kubectl -n fix get pods -o wide
kubectl -n fix get ingress
