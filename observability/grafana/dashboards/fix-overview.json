        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["mean"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count[1m])) or sum(rate(otelcol_receiver_accepted_spans[1m])) or vector(0)",
          "legendFormat": "Req/s Total",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Taxa de Requisições / Spans",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
