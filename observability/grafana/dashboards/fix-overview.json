          "legendFormat": "{{job}} - {{http_route}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (job) (rate(otelcol_receiver_accepted_spans[1m]))",
          "legendFormat": "Spans OTel ({{job}})",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Taxa de Requisições por Rota e Serviço",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
